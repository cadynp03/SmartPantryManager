<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="25dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Display Preferences"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Switch
        android:id="@+id/switchShowQuantities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Show ingredient quantities"
        android:checked="true"
        android:layout_marginBottom="15dp" />

    <Switch
        android:id="@+id/switchRecipeNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable recipe suggestions"
        android:checked="true"
        android:layout_marginBottom="25dp" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Settings"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back" />

</LinearLayout>